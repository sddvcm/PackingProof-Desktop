<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PackingPipTool</RootNamespace>
    <AssemblyName>PackingPipTool</AssemblyName>
    <Version>1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 默认中文 UI；不需要 langversion -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 关闭压缩：EnableCompressionInSingleFile 会把 native DLL 延迟解出，破坏 GDI+ 字体句柄，
         导致 WinForms Button/Label 文字渲染异常（不显示或乱码）。 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>